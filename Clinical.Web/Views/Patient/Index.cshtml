@model IEnumerable<Clinical.Web.Core.DTOs.Patient.PatientListDto>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div></div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Nuevo paciente
    </a>
</div>

<div class="table-card">
    <div class="table-header">
        <h6><i class="bi bi-people me-2 text-primary"></i>Listado de Pacientes</h6>
        <span class="badge bg-primary">@Model.Count()</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" data-datatable>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Documento</th>
                    <th>Nombre completo</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Género</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="text-muted">@p.PatientId</td>
                        <td>@p.DocumentNumber</td>
                        <td class="fw-semibold">@p.FullName</td>
                        <td>@p.Email</td>
                        <td>@p.Phone</td>
                        <td>@p.Gender</td>
                        <td>
                            <span class="badge badge-state @(p.State == 1 ? "badge-active" : "badge-inactive")">
                                @p.StatePatient
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@p.PatientId" class="btn btn-sm btn-outline-info" title="Detalle">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.PatientId" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="VitalSign" asp-action="ByPatient" asp-route-patientId="@p.PatientId" class="btn btn-sm btn-outline-secondary" title="Signos vitales">
                                    <i class="bi bi-heart-pulse"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.PatientId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar al paciente @p.FullName?" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
