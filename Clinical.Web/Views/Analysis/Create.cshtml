@model Clinical.Web.Core.DTOs.Analysis.CreateAnalysisDto
@{
    ViewData["Title"] = "Nuevo Análisis";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card mw-form-md">
    <h5 class="fw-bold mb-4"><i class="bi bi-flask me-2 text-primary"></i>Registrar Análisis</h5>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar</button>
        </div>
    </form>
</div>
