@model Clinical.Web.Core.DTOs.Analysis.UpdateAnalysisDto
@{
    ViewData["Title"] = "Editar Análisis";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card mw-form-md">
    <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Análisis</h5>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AnalysisId">
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"></div>
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar</button>
        </div>
    </form>
</div>
