@model Clinical.Web.Core.DTOs.Appointment.UpdateAppointmentDto
@{
    ViewData["Title"] = "Editar Cita";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Cita</h5>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AppointmentId">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PatientId" class="form-label"></label>
                <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients"><option value="">Seleccione...</option></select>
            </div>
            <div class="col-md-6">
                <label asp-for="DoctorId" class="form-label"></label>
                <select asp-for="DoctorId" class="form-select" asp-items="ViewBag.Doctors"><option value="">Seleccione...</option></select>
            </div>
            <div class="col-md-4">
                <label asp-for="AppointmentDate" class="form-label"></label>
                <input asp-for="AppointmentDate" class="form-control" type="datetime-local">
            </div>
            <div class="col-12"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar cambios</button>
        </div>
    </form>
</div>
