@model Clinical.Web.Core.DTOs.Appointment.AppointmentDetailDto
@{
    ViewData["Title"] = "Detalle de Cita";
}
<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
    <a asp-controller="PatientDiagnosis" asp-action="ByPatient" asp-route-patientId="@Model.PatientId" class="btn btn-sm btn-outline-success"><i class="bi bi-clipboard2-pulse me-1"></i>Diagnósticos</a>
    <a asp-controller="ExamResult" asp-action="Index" class="btn btn-sm btn-outline-info"><i class="bi bi-file-earmark-text me-1"></i>Resultados</a>
</div>
<div class="form-card">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded">
                <div class="small text-muted fw-semibold mb-1">PACIENTE</div>
                <div class="fw-bold fs-5">@Model.PatientFullName</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded">
                <div class="small text-muted fw-semibold mb-1">MÉDICO</div>
                <div class="fw-bold fs-5">Dr. @Model.DoctorFullName</div>
                <div class="text-muted small">@Model.DoctorSpecialty</div>
            </div>
        </div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">FECHA</div><div class="fw-semibold">@Model.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">ESTADO</div><span class="badge bg-success">@(Model.State == 1 ? "Activo" : "Otro")</span></div>
        <div class="col-12"><div class="text-muted small fw-semibold">MOTIVO</div><div>@Model.Reason</div></div>
        @if (!string.IsNullOrEmpty(Model.Diagnosis))
        {
            <div class="col-12"><div class="text-muted small fw-semibold">DIAGNÓSTICO</div><div>@Model.Diagnosis</div></div>
        }
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="col-12"><div class="text-muted small fw-semibold">NOTAS</div><div>@Model.Notes</div></div>
        }
    </div>
</div>
