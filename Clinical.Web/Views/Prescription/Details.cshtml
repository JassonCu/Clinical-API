@model Clinical.Web.Core.DTOs.Prescription.PrescriptionDetailDto
@{
    ViewData["Title"] = "Detalle de Receta";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded">
                <div class="small text-muted fw-semibold">PACIENTE</div>
                <div class="fw-bold">@Model.PatientFullName</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded">
                <div class="small text-muted fw-semibold">MÉDICO</div>
                <div class="fw-bold">Dr. @Model.DoctorFullName</div>
            </div>
        </div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">FECHA</div><div>@Model.PrescriptionDate.ToString("dd/MM/yyyy")</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">VÁLIDA HASTA</div><div>@(Model.ValidUntil?.ToString("dd/MM/yyyy") ?? "–")</div></div>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="col-12"><div class="text-muted small fw-semibold">NOTAS</div><div>@Model.Notes</div></div>
        }
    </div>

    <h6 class="fw-semibold mb-3"><i class="bi bi-capsule me-2"></i>Medicamentos</h6>
    <div class="table-responsive">
        <table class="table table-bordered mb-0">
            <thead class="table-light">
                <tr><th>Medicamento</th><th>Concentración</th><th>Cantidad</th><th>Dosis</th><th>Frecuencia</th><th>Duración</th><th>Instrucciones</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Details)
                {
                    <tr>
                        <td><div class="fw-semibold">@d.MedicineName</div><small class="text-muted">@d.GenericName</small></td>
                        <td>@d.Concentration</td>
                        <td>@d.Quantity</td>
                        <td>@d.Dosage</td>
                        <td>@d.Frequency</td>
                        <td>@d.Duration</td>
                        <td class="text-muted small">@(d.Instructions ?? "–")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
