@model Clinical.Web.Core.DTOs.Doctor.DoctorDetailDto
@{
    ViewData["Title"] = "Detalle del Médico";
}
<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
    <a asp-controller="Appointment" asp-action="Index" class="btn btn-sm btn-outline-info"><i class="bi bi-calendar2-check me-1"></i>Citas</a>
</div>
<div class="form-card">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="entity-avatar entity-avatar-green">@Model.FirstName.FirstOrDefault()</div>
        <div>
            <h4 class="mb-0 fw-bold">Dr. @Model.FirstName @Model.LastName</h4>
            <span class="badge bg-info text-dark">@Model.Specialty</span>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-4"><div class="text-muted small fw-semibold">DOCUMENTO</div><div class="fw-semibold">@Model.DocumentNumber</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">TARJETA PROFESIONAL</div><div class="fw-semibold">@(Model.MedicalLicense ?? "–")</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">EMAIL</div><div class="fw-semibold">@(Model.Email ?? "–")</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">TELÉFONO</div><div class="fw-semibold">@(Model.Phone ?? "–")</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">ESTADO</div><span class="badge @(Model.State == 1 ? "bg-success" : "bg-danger")">@(Model.State == 1 ? "Activo" : "Inactivo")</span></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">REGISTRADO</div><div class="fw-semibold">@Model.AuditCreateDate.ToString("dd/MM/yyyy")</div></div>
    </div>
</div>
