@model Clinical.Web.Core.DTOs.Doctor.UpdateDoctorDto
@{
    ViewData["Title"] = "Editar Médico";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Médico</h5>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DoctorId">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="DocumentNumber" class="form-label"></label><input asp-for="DocumentNumber" class="form-control"></div>
            <div class="col-md-4"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control"><span asp-validation-for="FirstName" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control"><span asp-validation-for="LastName" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Specialty" class="form-label"></label><input asp-for="Specialty" class="form-control"><span asp-validation-for="Specialty" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email"></div>
            <div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"></div>
            <div class="col-md-4"><label asp-for="MedicalLicense" class="form-label"></label><input asp-for="MedicalLicense" class="form-control"></div>
            <div class="col-md-4"><label asp-for="ConsultationFee" class="form-label"></label><input asp-for="ConsultationFee" class="form-control" type="number" step="0.01"></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar cambios</button>
        </div>
    </form>
</div>
