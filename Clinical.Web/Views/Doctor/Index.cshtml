@model IEnumerable<Clinical.Web.Core.DTOs.Doctor.DoctorListDto>
@{
    ViewData["Title"] = "Médicos";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo médico</a>
</div>

<div class="table-card">
    <div class="table-header">
        <h6><i class="bi bi-person-badge me-2 text-primary"></i>Listado de Médicos</h6>
        <span class="badge bg-primary">@Model.Count()</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" data-datatable>
            <thead>
                <tr><th>#</th><th>Documento</th><th>Nombre</th><th>Especialidad</th><th>Email</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="text-muted">@d.DoctorId</td>
                        <td>@d.DocumentNumber</td>
                        <td class="fw-semibold">@d.FullName</td>
                        <td><span class="badge bg-info text-dark">@d.Specialty</span></td>
                        <td>@d.Email</td>
                        <td>@d.Phone</td>
                        <td><span class="badge badge-state @(d.State == 1 ? "badge-active" : "badge-inactive")">@d.StateDoctor</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@d.DoctorId" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@d.DoctorId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@d.DoctorId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar al médico @d.FullName?"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
