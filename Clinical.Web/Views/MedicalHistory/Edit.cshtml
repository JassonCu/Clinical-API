@model Clinical.Web.Core.DTOs.MedicalHistory.UpdateMedicalHistoryDto
@{
    ViewData["Title"] = "Editar Historia Clínica";
}
<div class="mb-3"><a asp-controller="Patient" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Historia Clínica</h5>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MedicalHistoryId">
        <input type="hidden" asp-for="PatientId">
        <div class="row g-3">
            <div class="col-md-2">
                <label asp-for="BloodType" class="form-label"></label>
                <select asp-for="BloodType" class="form-select">
                    <option value="">–</option>
                    @foreach (var bt in new[]{"A+","A-","B+","B-","AB+","AB-","O+","O-"})
                    { <option>@bt</option> }
                </select>
            </div>
            <div class="col-md-6"><label asp-for="ChronicDiseases" class="form-label"></label><textarea asp-for="ChronicDiseases" class="form-control" rows="2"></textarea></div>
            <div class="col-md-6"><label asp-for="PreviousSurgeries" class="form-label"></label><textarea asp-for="PreviousSurgeries" class="form-control" rows="2"></textarea></div>
            <div class="col-md-6"><label asp-for="FamilyHistory" class="form-label"></label><textarea asp-for="FamilyHistory" class="form-control" rows="2"></textarea></div>
            <div class="col-md-6"><label asp-for="CurrentMedications" class="form-label"></label><textarea asp-for="CurrentMedications" class="form-control" rows="2"></textarea></div>
            <div class="col-md-6"><label asp-for="Habits" class="form-label"></label><textarea asp-for="Habits" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label asp-for="Observations" class="form-label"></label><textarea asp-for="Observations" class="form-control" rows="3"></textarea></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar cambios</button>
        </div>
    </form>
</div>
