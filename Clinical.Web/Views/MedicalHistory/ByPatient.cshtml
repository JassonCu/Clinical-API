@model IEnumerable<Clinical.Web.Core.DTOs.MedicalHistory.MedicalHistoryDto>
@{
    ViewData["Title"] = "Historia Clínica";
    var patientId = (int)ViewBag.PatientId;
}
<div class="mb-3 d-flex gap-2">
    <a asp-controller="Patient" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus me-1"></i>Nuevo registro</a>
</div>
@foreach (var h in Model)
{
    <div class="form-card mb-3">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h6 class="fw-bold mb-0">@h.PatientFullName</h6>
                <small class="text-muted">Actualizado: @(h.LastUpdatedDate?.ToString("dd/MM/yyyy") ?? h.AuditCreateDate.ToString("dd/MM/yyyy"))</small>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@h.MedicalHistoryId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                <form asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@h.MedicalHistoryId">
                    <input type="hidden" name="patientId" value="@patientId">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar este registro?"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-2"><div class="text-muted small fw-semibold">GRUPO SANGUÍNEO</div><span class="badge bg-danger fs-6">@(h.BloodType ?? "–")</span></div>
            @if (!string.IsNullOrEmpty(h.ChronicDiseases))
            {
                <div class="col-md-5"><div class="text-muted small fw-semibold">ENFERMEDADES CRÓNICAS</div><div>@h.ChronicDiseases</div></div>
            }
            @if (!string.IsNullOrEmpty(h.PreviousSurgeries))
            {
                <div class="col-md-5"><div class="text-muted small fw-semibold">CIRUGÍAS PREVIAS</div><div>@h.PreviousSurgeries</div></div>
            }
            @if (!string.IsNullOrEmpty(h.FamilyHistory))
            {
                <div class="col-md-6"><div class="text-muted small fw-semibold">ANTECEDENTES FAMILIARES</div><div>@h.FamilyHistory</div></div>
            }
            @if (!string.IsNullOrEmpty(h.CurrentMedications))
            {
                <div class="col-md-6"><div class="text-muted small fw-semibold">MEDICAMENTOS ACTUALES</div><div>@h.CurrentMedications</div></div>
            }
            @if (!string.IsNullOrEmpty(h.Habits))
            {
                <div class="col-md-6"><div class="text-muted small fw-semibold">HÁBITOS</div><div>@h.Habits</div></div>
            }
            @if (!string.IsNullOrEmpty(h.Observations))
            {
                <div class="col-12"><div class="text-muted small fw-semibold">OBSERVACIONES</div><div>@h.Observations</div></div>
            }
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x fs-1"></i>
        <p class="mt-3">No hay registros de historia clínica para este paciente.</p>
        <a asp-action="Create" class="btn btn-primary">Crear primer registro</a>
    </div>
}
