@model IEnumerable<Clinical.Web.Core.DTOs.PatientAllergy.AllergyDto>
@{
    ViewData["Title"] = "Alergias del Paciente";
}
<div class="mb-3 d-flex gap-2">
    <a asp-controller="Patient" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    <a asp-action="Create" class="btn btn-sm btn-warning"><i class="bi bi-plus me-1"></i>Registrar alergia</a>
</div>
<div class="table-card">
    <div class="table-header"><h6><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Alergias Registradas</h6></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Tipo</th><th>Alérgeno</th><th>Reacción</th><th>Severidad</th><th>Notas</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.AllergenType</td>
                        <td class="fw-semibold">@a.AllergenName</td>
                        <td class="text-muted small">@(a.Reaction ?? "–")</td>
                        <td><span class="badge @(a.Severity == "Anafilaxia" ? "bg-danger" : a.Severity == "Grave" ? "bg-warning text-dark" : "bg-info text-dark")">@a.Severity</span></td>
                        <td class="text-muted small">@(a.Notes ?? "–")</td>
                        <td><span class="badge @(a.State == 1 ? "bg-success" : "bg-secondary")">@(a.State == 1 ? "Activa" : "Inactiva")</span></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-check-circle me-2 text-success"></i>Sin alergias registradas</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
