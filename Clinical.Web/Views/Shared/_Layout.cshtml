<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] – Clinical System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- SIDEBAR -->
    <nav id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-hospital me-2"></i>Clinical System
            <small>Sistema Clínico</small>
        </div>

        <div class="py-2">
            <div class="nav-section">Principal</div>
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="User" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                    <i class="bi bi-people-fill"></i> Usuarios
                </a>
            }

            <div class="nav-section mt-2">Gestión Clínica</div>
            <a asp-controller="Patient" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" ? "active" : "")">
                <i class="bi bi-people"></i> Pacientes
            </a>
            <a asp-controller="Doctor" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" ? "active" : "")">
                <i class="bi bi-person-badge"></i> Médicos
            </a>
            <a asp-controller="Appointment" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointment" ? "active" : "")">
                <i class="bi bi-calendar2-check"></i> Citas
            </a>
            <a asp-controller="VitalSign" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VitalSign" ? "active" : "")">
                <i class="bi bi-heart-pulse"></i> Signos Vitales
            </a>
            <a asp-controller="MedicalHistory" asp-action="ByPatient" asp-route-patientId="0" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalHistory" ? "active" : "")">
                <i class="bi bi-journal-medical"></i> Historia Clínica
            </a>

            <div class="nav-section mt-2">Diagnóstico</div>
            <a asp-controller="PatientAllergy" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PatientAllergy" ? "active" : "")">
                <i class="bi bi-exclamation-triangle"></i> Alergias
            </a>
            <a asp-controller="PatientDiagnosis" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PatientDiagnosis" ? "active" : "")">
                <i class="bi bi-clipboard2-pulse"></i> Diagnósticos
            </a>

            <div class="nav-section mt-2">Laboratorio</div>
            <a asp-controller="Analysis" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" ? "active" : "")">
                <i class="bi bi-flask"></i> Análisis
            </a>
            <a asp-controller="Exam" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Exam" ? "active" : "")">
                <i class="bi bi-eyedropper"></i> Exámenes
            </a>
            <a asp-controller="ExamResult" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ExamResult" ? "active" : "")">
                <i class="bi bi-file-earmark-text"></i> Resultados
            </a>

            <div class="nav-section mt-2">Farmacia</div>
            <a asp-controller="Medicine" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Medicine" ? "active" : "")">
                <i class="bi bi-capsule"></i> Medicamentos
            </a>
            <a asp-controller="Prescription" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Prescription" ? "active" : "")">
                <i class="bi bi-file-medical"></i> Recetas
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="sidebar-avatar">
                    @(User.FindFirst("full_name")?.Value?.Split(' ').Select(s => s.FirstOrDefault()).Take(2).ToArray() is { } i ? new string(i) : "U")
                </div>
                <div>
                    <div class="sidebar-username">@User.FindFirst("full_name")?.Value</div>
                    <div class="sidebar-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                </div>
            </div>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100 text-start sidebar-logout">
                    <i class="bi bi-box-arrow-left me-2"></i>Cerrar sesión
                </button>
            </form>
        </div>
    </nav>

    <!-- MAIN -->
    <div id="main-content">
        <div class="topbar">
            <div class="d-flex align-items-center gap-3">
                <button id="sidebar-toggle" class="btn btn-sm btn-outline-secondary d-md-none">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-title">@ViewData["Title"]</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                <small class="text-muted">@DateTime.Now.ToString("dd MMM yyyy")</small>
            </div>
        </div>

        <div class="content-area">
            @await Html.PartialAsync("_Alerts")
            @RenderBody()
        </div>
    </div>
}
else
{
    @RenderBody()
}

<!-- Confirm modal (reemplaza SweetAlert2 — sin estilos inline) -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="confirmMessage"></div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmBtn">Sí, continuar</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
