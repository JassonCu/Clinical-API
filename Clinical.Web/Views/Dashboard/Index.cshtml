@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-accent-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-value text-primary">@ViewBag.TotalPatients</div>
                    <div class="stat-label mt-1">Pacientes</div>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people-fill"></i></div>
            </div>
            <a asp-controller="Patient" asp-action="Index" class="text-decoration-none text-muted small mt-2 d-block">
                Ver todos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-accent-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-value text-success">@ViewBag.TotalDoctors</div>
                    <div class="stat-label mt-1">Médicos</div>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-badge-fill"></i></div>
            </div>
            <a asp-controller="Doctor" asp-action="Index" class="text-decoration-none text-muted small mt-2 d-block">
                Ver todos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-accent-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-value text-info">@ViewBag.TotalAppointments</div>
                    <div class="stat-label mt-1">Citas</div>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-calendar2-check-fill"></i></div>
            </div>
            <a asp-controller="Appointment" asp-action="Index" class="text-decoration-none text-muted small mt-2 d-block">
                Ver todas <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card @(ViewBag.LowStockCount > 0 ? "stat-accent-danger" : "stat-accent-warning")">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-value @(ViewBag.LowStockCount > 0 ? "text-danger" : "text-warning")">@ViewBag.LowStockCount</div>
                    <div class="stat-label mt-1">Stock crítico</div>
                </div>
                <div class="stat-icon @(ViewBag.LowStockCount > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-warning bg-opacity-10 text-warning")">
                    <i class="bi bi-capsule-pill"></i>
                </div>
            </div>
            <a asp-controller="Medicine" asp-action="LowStock" class="text-decoration-none text-muted small mt-2 d-block">
                Ver detalle <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="table-card">
            <div class="table-header">
                <h6><i class="bi bi-calendar2-check me-2 text-primary"></i>Últimas Citas</h6>
                <a asp-controller="Appointment" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Médico</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in (IEnumerable<Clinical.Web.Core.DTOs.Appointment.AppointmentListDto>)ViewBag.RecentAppointments)
                        {
                            <tr>
                                <td>@a.PatientFullName</td>
                                <td>@a.DoctorFullName</td>
                                <td>@a.AppointmentDate.ToString("dd/MM/yy HH:mm")</td>
                                <td><span class="badge badge-state badge-active">@a.StateAppointment</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="table-card">
            <div class="table-header">
                <h6><i class="bi bi-capsule me-2 text-danger"></i>Medicamentos con Stock Bajo</h6>
                <a asp-controller="Medicine" asp-action="LowStock" class="btn btn-sm btn-outline-danger">Ver todos</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Medicamento</th>
                            <th>Stock</th>
                            <th>Mín.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in (IEnumerable<Clinical.Web.Core.DTOs.Medicine.MedicineListDto>)ViewBag.LowStockMedicines)
                        {
                            <tr>
                                <td>@m.Name</td>
                                <td><span class="badge @(m.CurrentStock == 0 ? "bg-danger" : "bg-warning text-dark")">@m.CurrentStock</span></td>
                                <td class="text-muted">@m.MinimumStock</td>
                            </tr>
                        }
                        @if (ViewBag.LowStockCount == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3"><i class="bi bi-check-circle me-2 text-success"></i>Stock en buen nivel</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
