@model Clinical.Web.Core.DTOs.Exam.CreateExamDto
@{
    ViewData["Title"] = "Nuevo Examen";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-eyedropper me-2 text-primary"></i>Registrar Examen</h5>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-md-6">
                <label asp-for="AnalysisId" class="form-label"></label>
                <select asp-for="AnalysisId" class="form-select" asp-items="ViewBag.Analyses"><option value="">Seleccione análisis...</option></select>
                <span asp-validation-for="AnalysisId" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar</button>
        </div>
    </form>
</div>
