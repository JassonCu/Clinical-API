@model Clinical.Web.Core.DTOs.Medicine.CreateMedicineDto
@{
    ViewData["Title"] = "Nuevo Medicamento";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-capsule me-2 text-primary"></i>Registrar Medicamento</h5>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control"><span asp-validation-for="Code" class="text-danger small"></span></div>
            <div class="col-md-5"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="GenericName" class="form-label"></label><input asp-for="GenericName" class="form-control"></div>
            <div class="col-md-4"><label asp-for="Brand" class="form-label"></label><input asp-for="Brand" class="form-control"></div>
            <div class="col-md-4"><label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select">
                    <option value="">Seleccione...</option>
                    @foreach (var c in new[]{"Analgésico","Antibiótico","Antiinflamatorio","Antihipertensivo","Antidiabético","Vitamina","Otro"})
                    { <option>@c</option> }
                </select>
            </div>
            <div class="col-md-4"><label asp-for="Presentation" class="form-label"></label><input asp-for="Presentation" class="form-control" placeholder="ej: Tabletas, Jarabe"></div>
            <div class="col-md-4"><label asp-for="Concentration" class="form-label"></label><input asp-for="Concentration" class="form-control" placeholder="ej: 500mg"></div>
            <div class="col-md-2"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" placeholder="ej: mg"></div>
            <div class="col-md-2"><label asp-for="CurrentStock" class="form-label"></label><input asp-for="CurrentStock" class="form-control" type="number"></div>
            <div class="col-md-2"><label asp-for="MinimumStock" class="form-label"></label><input asp-for="MinimumStock" class="form-control" type="number"></div>
            <div class="col-md-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" type="number" step="0.01"></div>
            <div class="col-md-3"><label asp-for="ExpirationDate" class="form-label"></label><input asp-for="ExpirationDate" class="form-control" type="date"></div>
            <div class="col-12"><label asp-for="StorageConditions" class="form-label"></label><input asp-for="StorageConditions" class="form-control"></div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="RequiresPrescription" class="form-check-input" type="checkbox">
                    <label asp-for="RequiresPrescription" class="form-check-label">Requiere receta médica</label>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar</button>
        </div>
    </form>
</div>
