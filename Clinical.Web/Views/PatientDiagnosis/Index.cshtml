@model IEnumerable<Clinical.Web.Core.DTOs.PatientDiagnosis.DiagnosisDto>
@{
    ViewData["Title"] = "Diagnósticos";
}
<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo diagnóstico</a>
</div>
<div class="table-card">
    <div class="table-header"><h6><i class="bi bi-clipboard2-pulse me-2 text-primary"></i>Diagnósticos</h6><span class="badge bg-primary">@Model.Count()</span></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" data-datatable>
            <thead><tr><th>Paciente</th><th>Código CIE-10</th><th>Descripción</th><th>Tipo</th><th>Estado</th><th>Fecha</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="fw-semibold">@d.PatientFullName</td>
                        <td><span class="badge bg-secondary font-monospace">@d.IcdCode</span></td>
                        <td>@d.Description</td>
                        <td class="text-muted small">@(d.DiagnosisType ?? "–")</td>
                        <td><span class="badge @(d.State == 1 ? "bg-success" : "bg-secondary")">@(d.State == 1 ? "Activo" : "Inactivo")</span></td>
                        <td>@d.AuditCreateDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@d.DiagnosisId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar este diagnóstico?"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
