@model Clinical.Web.Core.DTOs.PatientDiagnosis.CreateDiagnosisDto
@{
    ViewData["Title"] = "Nuevo Diagnóstico";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-clipboard2-plus me-2 text-primary"></i>Registrar Diagnóstico</h5>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PatientId" class="form-label"></label>
                <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients"><option value="">Seleccione...</option></select>
                <span asp-validation-for="PatientId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AppointmentId" class="form-label"></label>
                <select asp-for="AppointmentId" class="form-select" asp-items="ViewBag.Appointments"><option value="">Seleccione...</option></select>
                <span asp-validation-for="AppointmentId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="IcdCode" class="form-label"></label>
                <input asp-for="IcdCode" class="form-control font-monospace" placeholder="ej: J45.0">
                <span asp-validation-for="IcdCode" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DiagnosisType" class="form-label"></label>
                <select asp-for="DiagnosisType" class="form-select">
                    <option value="">Seleccione...</option>
                    <option>Principal</option>
                    <option>Secundario</option>
                    <option>Presuntivo</option>
                    <option>Definitivo</option>
                </select>
            </div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar</button>
        </div>
    </form>
</div>
