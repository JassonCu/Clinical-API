@model IEnumerable<Clinical.Web.Core.DTOs.ExamResult.ExamResultListDto>
@{
    ViewData["Title"] = "Resultados de Exámenes";
}
<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Registrar resultado</a>
</div>
<div class="table-card">
    <div class="table-header"><h6><i class="bi bi-file-earmark-text me-2 text-primary"></i>Resultados de Exámenes</h6><span class="badge bg-primary">@Model.Count()</span></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" data-datatable>
            <thead><tr><th>Paciente</th><th>Examen</th><th>Análisis</th><th>Resultado</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-semibold">@r.PatientFullName</td>
                        <td>@r.ExamName</td>
                        <td class="text-muted small">@r.AnalysisName</td>
                        <td class="text-truncate mw-col-sm">@r.Result</td>
                        <td>@r.ResultDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge badge-state badge-active">@r.StateResult</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@r.ExamResultId" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                <form asp-action="Delete" asp-route-id="@r.ExamResultId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar este resultado?"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
