@model Clinical.Web.Core.DTOs.ExamResult.CreateExamResultDto
@{
    ViewData["Title"] = "Registrar Resultado";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <h5 class="fw-bold mb-4"><i class="bi bi-file-earmark-plus me-2 text-primary"></i>Registrar Resultado de Examen</h5>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="PatientId" class="form-label"></label>
                <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients"><option value="">Seleccione...</option></select>
                <span asp-validation-for="PatientId" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="ExamId" class="form-label"></label>
                <select asp-for="ExamId" class="form-select" asp-items="ViewBag.Exams"><option value="">Seleccione...</option></select>
                <span asp-validation-for="ExamId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ResultDate" class="form-label"></label>
                <input asp-for="ResultDate" class="form-control" type="date">
                <span asp-validation-for="ResultDate" class="text-danger small"></span>
            </div>
            <div class="col-12"><label asp-for="Result" class="form-label"></label><textarea asp-for="Result" class="form-control" rows="3"></textarea><span asp-validation-for="Result" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Observations" class="form-label"></label><textarea asp-for="Observations" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-floppy me-2"></i>Guardar</button>
        </div>
    </form>
</div>
