@model Clinical.Web.Core.DTOs.ExamResult.ExamResultDetailDto
@{
    ViewData["Title"] = "Detalle de Resultado";
}
<div class="mb-3"><a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a></div>
<div class="form-card">
    <div class="row g-3">
        <div class="col-md-4"><div class="text-muted small fw-semibold">PACIENTE</div><div class="fw-bold">@Model.PatientFullName</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">EXAMEN</div><div class="fw-bold">@Model.ExamName</div><div class="text-muted small">@Model.AnalysisName</div></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">FECHA</div><div class="fw-bold">@Model.ResultDate.ToString("dd/MM/yyyy")</div></div>
        <div class="col-12">
            <div class="text-muted small fw-semibold">RESULTADO</div>
            <div class="p-3 bg-light rounded border mt-1">@Model.Result</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Observations))
        {
            <div class="col-12"><div class="text-muted small fw-semibold">OBSERVACIONES</div><div>@Model.Observations</div></div>
        }
        <div class="col-md-4"><div class="text-muted small fw-semibold">ESTADO</div><span class="badge @(Model.State == 1 ? "bg-success" : "bg-secondary")">@(Model.State == 1 ? "Activo" : "Inactivo")</span></div>
        <div class="col-md-4"><div class="text-muted small fw-semibold">REGISTRADO</div><div>@Model.AuditCreateDate.ToString("dd/MM/yyyy")</div></div>
    </div>
</div>
